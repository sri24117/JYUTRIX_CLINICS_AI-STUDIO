# Application mode: demo | production
APP_MODE=production
PORT=3000
PUBLIC_URL=https://clinic.yourdomain.com
SITE_DOMAIN=clinic.yourdomain.com

# Local admin fallback (required in production)
ADMIN_PASSWORD=
# Optional: Clerk user with this email is automatically granted platform admin role
ADMIN_EMAIL=

# PostgreSQL (set automatically in compose.yaml via POSTGRES_PASSWORD)
POSTGRES_PASSWORD=
DATABASE_URL=

# Clerk authentication (optional — enables Clerk Sign-In/Sign-Up + clinic self-onboarding)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Kapso WhatsApp integration
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_API_VERSION=v24.0
REMINDER_TEMPLATE=jyutrix_appointment_reminder
REMINDER_BUTTON_TEMPLATE=jyutrix_appointment_reminder_buttons
TEMPLATE_LANGUAGE=en_US

# Optional integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
VOICE_TOOL_KEY=
RETENTION_DAYS=90